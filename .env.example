THREATLENS_ADMIN_USERNAME=admin
THREATLENS_ADMIN_PASSWORD=replace-with-a-long-unique-password
THREATLENS_DATABASE_URL=sqlite:///threatlens.db
THREATLENS_SESSION_HOURS=12
THREATLENS_SECURE_COOKIES=false
THREATLENS_LOG_LEVEL=INFO
THREATLENS_VERSION=dev

BRUTE_FORCE_THRESHOLD=5
BRUTE_FORCE_WINDOW_SECONDS=300
PASSWORD_SPRAY_USER_THRESHOLD=5
PASSWORD_SPRAY_WINDOW_SECONDS=600
SUSPICIOUS_SUCCESS_FAILURE_THRESHOLD=3
SUSPICIOUS_SUCCESS_WINDOW_SECONDS=600
MAX_UPLOAD_MB=2
MAX_LOG_LINES=50000
